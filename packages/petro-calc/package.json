{
  "name": "@petroatlas/petro-calc",
  "version": "0.1.0",
  "description": "Petroleum engineering calculations: decline curves, IPR, PVT, diagnostics and unit conversions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuricatoAviones/petro-atlas.git",
    "directory": "packages/petro-calc"
  },
  "keywords": [
    "petroleum-engineering",
    "decline-curve",
    "arps",
    "ipr",
    "pvt",
    "petro-calc"
  ],
  "type": "module",
