{
  "name": "petroatlas",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source oil well explorer: map, production and pressure series, and engineering tools.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm --recursive --if-present run build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --project petro-calc --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && pnpm --recursive --if-present run typecheck",
    "db:migrate": "pnpm --filter @petroatlas/db migrate",
    "db:seed": "pnpm --filter @petroatlas/db seed",
    "skills:link": "node scripts/link-skills.mjs",
    "etl:sodir": "pnpm --filter @petroatlas/etl sodir",
    "etl:volve": "pnpm --filter @petroatlas/etl volve",
    "etl:all": "pnpm etl:sodir && pnpm etl:volve"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
