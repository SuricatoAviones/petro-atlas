{
  "name": "@petroatlas/api",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only REST API over PostgreSQL + PostGIS.",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --conditions=@petroatlas/source src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@petroatlas/shared-types": "workspace:*",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1"
  }
}
