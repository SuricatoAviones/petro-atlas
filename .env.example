# Copy to .env to override the development defaults. Never commit .env.
# `docker compose up` works without this file.

# --- PostgreSQL + PostGIS (docker-compose.yml) ---
POSTGRES_DB=petroatlas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
# Read-write role: migrations and seed.
PETROATLAS_ETL_PASSWORD=etl_dev_password
# Read-only role: API.
PETROATLAS_API_PASSWORD=api_dev_password

# --- Host ports published by Docker Compose ---
DB_PORT=55432
API_PORT=4000
WEB_PORT=3000

# --- Running outside Docker (pnpm dev, pnpm db:migrate, pnpm db:seed) ---
ETL_DATABASE_URL=postgres://petroatlas_etl:etl_dev_password@localhost:55432/petroatlas
API_DATABASE_URL=postgres://petroatlas_api:api_dev_password@localhost:55432/petroatlas
# --- API ---
# The only origin allowed by CORS.
WEB_ORIGIN=http://localhost:3000
RATE_LIMIT_PER_MINUTE=1200

# --- Web ---
# MapLibre style of the basemap, inlined at build time. Defaults to OpenFreeMap's positron.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# URL of the API as the browser reaches it, inlined at build time. Change it together with
# API_PORT, and set WEB_ORIGIN to the address the web is served from.
# NEXT_PUBLIC_API_URL=http://localhost:4000
